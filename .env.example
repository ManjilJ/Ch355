# --- Build & Tooling (Frontend) ---
DISABLE_ESLINT_PLUGIN=true
GENERATE_SOURCEMAP=false

# --- Authentication & Database (Backend) ---
JWT_SECRET=change_to_a_long_random_string
DB_FILE=./ch355.db

# --- Repo Info (Backend) ---
GITHUB_REPO_URL=https://github.com/manjilj/Ch355

# --- Networking & CORS ---
PORT=8083
REACT_APP_CHESS_BACKEND_URL=http://localhost:8083
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Game Rules ---
# Clock timer in milliseconds (e.g. 3600000 = 60 minutes, 300000 = 5 minutes)
CHESS_TIME_MS=3600000